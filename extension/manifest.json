{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "3.1.0",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "minimum_chrome_version": "111",
  "permissions": [
    "storage",
    "permissions",
    "sidePanel",
    "tabs"
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "host_permissions": [
    "https://*/*"
  ],
  "optional_host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://*/*"
      ],
      "js": [
        "inject.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "ShieldAI Firewall"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "overlay.css",
        "welcome.html",
        "i18n.js",
        "locales/en/messages.json",
        "locales/zh/messages.json",
        "locales/vi/messages.json"
      ],
      "matches": [
        "https://*/*"
      ]
    }
  ],
  "icons": {
    "16": "icons/shield16.png",
    "48": "icons/shield48.png",
    "128": "icons/shield128.png"
  }
}
