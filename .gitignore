# Environment
.env
.env.*
!.env.example
venv/
env/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# IDE
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log
logs/

# OS
.DS_Store
Thumbs.db

# Testing
.pytest_cache/
.coverage

# Database
*.db
*.db-shm
*.db-wal
*.sqlite3

# Eval runtime outputs (generated by VPS eval runs)
eval/data/live_scores*.json

# VPS-generated weekly metrics log (cron on VPS appends; reproducible from SQLite)
metrics/log.md

# VPS-only ops scripts (must read secrets from .env, never commit)
daily_summary.sh
watchdog.sh

# Demo materials (videos, presentations)
demo/
*.mp4
*.avi
*.mov

# PDF files
*.pdf

# Landing page dependencies (source is landing-src/, build output is landing/)
/landing-src/node_modules/

# Dashboard build artifacts (source is dashboard/index.src.html; output is dashboard/index.html)
dashboard/build/node_modules/
dashboard/build/tw.css

# Build scripts (local tooling)
scripts/build_*.py

# Screenshots and zips
*.png
!/landing-src/public/*.png
!/landing/*.png
*.zip

# Local working docs (investor decks, roadmaps)
docs/ShieldBot_Explained*
docs/ShieldBot_Investor*

# Documentation images are ALLOWED
!docs/images/
!docs/images/*.png
!docs/images/*.jpg
!docs/images/*.gif
