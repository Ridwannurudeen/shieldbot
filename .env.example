# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_ALERT_CHAT_ID=your_personal_chat_id_here
WEBHOOK_SECRET=your_random_secret_here  # used to authenticate /webhook/uptime calls
WEBHOOK_ALLOW_QUERY_SECRET=false  # set true to allow ?secret= (deprecated)

# BSC API
BSCSCAN_API_KEY=your_bscscan_api_key_here

# AI Analysis (REQUIRED for AI-powered features)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# ANTHROPIC_MODEL=claude-3-haiku-20240307

# On-Chain Recording (REQUIRED for recording scans to BSC)
BOT_WALLET_PRIVATE_KEY=your_bot_wallet_private_key_here

# RPC Endpoints
BSC_RPC_URL=https://bsc-dataseed.binance.org/
OPBNB_RPC_URL=https://opbnb-mainnet-rpc.bnbchain.org
BASE_RPC_URL=https://mainnet.base.org
# Robinhood Chain RPC (defaults to the public mainnet endpoint when empty)
ROBINHOOD_RPC_URL=
# Blockscout PRO API key for Robinhood Chain explorer data
BLOCKSCOUT_API_KEY=
# ShieldBotVerdictRegistry address on Robinhood Chain; publishing is off while it is empty.
# See contracts/base/DEPLOY_ROBINHOOD.md to deploy it and set the recorder.
ROBINHOOD_VERDICT_REGISTRY=
# ROBINHOOD_RECORDER_PRIVATE_KEY is deliberately NOT set here. Only the API service sends
# verdict transactions, so its key belongs in that unit's own environment file
# (/etc/shieldbot/recorder.env, root-owned, mode 600), never in this shared file.

# Archive RPCs for approval scanning (eth_getLogs over full chain history)
# Public endpoints rate-limit and reject 50k-block ranges — use a paid provider.
LOGS_RPC_URL=                      # BSC archive (NodeReal/QuickNode/Alchemy)
BASE_LOGS_RPC_URL=                 # Base archive (Alchemy/QuickNode)

# Base EAS attestation (set after deploying ShieldBotAttestor on Base mainnet)
BASE_ATTESTOR_ADDRESS=             # deployed attestor contract address
BASE_ATTESTOR_SCHEMA_UID=          # EAS schema UID returned by RegisterSchema.s.sol
BASE_VERIFIER_PRIVATE_KEY=         # bot signing key — separate wallet from contract owner

# Tenderly (transaction simulation)
TENDERLY_API_KEY=your_tenderly_api_key_here
TENDERLY_PROJECT_ID=your_project_id_here
TENDERLY_CB_MAX_FAILURES=3
TENDERLY_CB_COOLDOWN=60

# Ethos Network (optional — wallet reputation via Privy)
ETHOS_PRIVY_TOKEN=your_privy_token_here

# CORS — comma-separated allowed origins for the API
# Include your chrome-extension:// ID for production
# CORS — restrict to your actual domains in production (never use * with credentials)
CORS_ALLOW_ORIGINS=https://shieldbotsecurity.online,https://api.shieldbotsecurity.online,http://localhost:5173,http://localhost:3000
CORS_ALLOW_ALL=false  # set true to allow "*" (credentials will be disabled)

# Reverse proxy trust (comma-separated IPs of trusted proxies)
TRUSTED_PROXY_IPS=127.0.0.1

# Rate limits: memory (the default) counts in each API process and forgets on restart; redis shares
# one count per caller between API processes, in the Redis at REDIS_URL. See docs/DEPLOYMENT.md.
# RATE_LIMIT_BACKEND=memory
# REDIS_URL=redis://localhost:6379/0

# Token Sniffer (bytecode fingerprinting for unverified contracts — register free at tokensniffer.com)
TOKEN_SNIFFER_API_KEY=your_token_sniffer_api_key_here

# Resend (beta welcome emails and self-serve free key emails; free keys are off without it)
RESEND_API_KEY=your_resend_api_key_here
# RESEND_FROM_EMAIL=ShieldBot <noreply@shieldbotsecurity.online>
# Public base URL of this API for the links in free key emails (never taken from a request)
# PUBLIC_API_URL=https://api.shieldbotsecurity.online
# Daily AI token cap (input plus output, per UTC day) for chat and explanations; 0 pauses AI
# AI_DAILY_TOKEN_BUDGET=1000000

# Admin
ADMIN_SECRET=your_admin_secret_here

# Bot Settings
RISK_THRESHOLD=70
CACHE_DURATION=300

# Local API URL. The metrics snapshot (scripts/snapshot_metrics.py) reads it, and so does the
# Telegram bot, which gets live mempool data for /threats from the API. The host allowlist below
# applies to the metrics snapshot only.
SHIELDBOT_API_URL=http://127.0.0.1:8000
SHIELDBOT_API_HOST_ALLOWLIST=127.0.0.1,localhost
